@page "/auth"
@rendermode InteractiveServer


<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudPaper Elevation="25" Class="pa-8" Style="border-radius: 16px; background: rgba(255,255,255,0.9); backdrop-filter: blur(10px);">
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Centered="true" Color="Color.Primary">
            
            @* --- Login Section --- *@
            <MudTabPanel ID='"login"' Text="Login">
                <MudForm @ref="loginForm" @bind-IsValid="@isLoginValid">
                    <div class="d-flex flex-column gap-y-4 pt-6">
                        <MudText Typo="Typo.h4" Align="Align.Center" Class="fw-bold mb-4">Welcome Back</MudText>
                        
                        <MudTextField T="string" Label="Email" Variant="Variant.Outlined" 
                                      @bind-Value="logInDTO.Email" Required="true" 
                                      InputType="InputType.Email" Adornment="Adornment.Start" 
                                      AdornmentIcon="@Icons.Material.Filled.Email" />

                        <MudTextField T="string" Label="Password" Variant="Variant.Outlined" 
                                      @bind-Value="logInDTO.Password" Required="true" 
                                      InputType="InputType.Password" Adornment="Adornment.Start" 
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />

                        <div class="d-flex justify-space-between align-center px-2">
                            <MudCheckBox T="bool" Label="Remember me" Color="Color.Primary" Dense="true" />
                            <MudLink Typo="Typo.body2" Color="Color.Secondary">Forgot Password?</MudLink>
                        </div>

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" 
                                   Size="Size.Large" Class="mt-4 py-3" OnClick="OnLoginClick" 
                                   Style="border-radius: 10px;">
                            SIGN IN
                        </MudButton>
                    </div>
                </MudForm>
            </MudTabPanel>

            @* --- Register Section --- *@
            <MudTabPanel Text="Register" ID='"register"'>
                <MudForm @ref="registerForm" @bind-IsValid="@isRegisterValid">
                    <div class="d-flex flex-column gap-y-4 pt-6">
                        <MudText Typo="Typo.h4" Align="Align.Center" Class="fw-bold mb-4">Create Account</MudText>

                        <MudTextField T="string" Label="Full Name" Variant="Variant.Outlined" 
                                      @bind-Value="registerDTO.Fullname" Required="true" 
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person" />

                        <MudTextField T="string" Label="Email" Variant="Variant.Outlined" 
                                      @bind-Value="registerDTO.Email" Required="true"
                                      InputType="InputType.Email" Adornment="Adornment.Start" 
                                      AdornmentIcon="@Icons.Material.Filled.Email" />

                        <MudTextField T="string" Label="Password" Variant="Variant.Outlined" 
                                      @bind-Value="registerDTO.Password" Required="true"
                                      InputType="InputType.Password" Adornment="Adornment.Start" 
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />

                        <MudCheckBox T="bool" Required="true" Label="I agree to the Terms & Conditions" 
                                     Color="Color.Primary" Class="mt-2" />

                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true" 
                                   Size="Size.Large" Class="mt-4 py-3" OnClick="OnRegisterClick" 
                                   Style="border-radius: 10px;">
                            REGISTER NOW
                        </MudButton>
                    </div>
                </MudForm>
            </MudTabPanel>
        </MudTabs>

        <MudDivider Class="my-6" />
        
        <div class="d-flex justify-center gap-x-4">
            <MudIconButton Icon="@Icons.Custom.Brands.Google" Variant="Variant.Outlined" Color="Color.Error" />
            <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Variant="Variant.Outlined" Color="Color.Dark" />
        </div>
    </MudPaper>
</MudContainer>